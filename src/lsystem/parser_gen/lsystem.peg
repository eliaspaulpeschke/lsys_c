    ParserStr * aux = mk_parser_str(in);
    ParseData * res;
    lsys_context_t *ctx = lsys_create(NULL);
    while (lsys_parse(ctx, &res)){
      printf("Parsed %d\n", res->list_length);
          print_pd(res ,"  ");
    }
    lsys_destroy(ctx);
    return res;
}*/

int main(){
    ParserStr * aux = mk_parser_str("F(j)G(k) -> FF \n a1 : F(G) -> U \n PP < F -> G \n EOF");
    ParseData * res;
    lsys_context_t *ctx = lsys_create(aux);
    while (lsys_parse(ctx, &res));
    lsys_destroy(ctx);
    return 0;
}
